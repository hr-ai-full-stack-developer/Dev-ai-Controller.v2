# Dev’ai Controller local configuration
# Copy to .env for local Node development. Never commit real values.

# Required operator authentication
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_JWT_KEY=

# Required only for GitHub Actions deployment (repository Actions secrets)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional runtime integrations
GITHUB_TOKEN=
RESEND_API_KEY=
# Verified OPERAVA sender, for example: OPERAVA <noreply@your-verified-domain>
EMAIL_FROM=
# Verified destination used by the Cloudflare inbound email() forwarding handler
EMAIL_FORWARD_TO=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional application persistence integration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Recommended: dedicated Supabase project/database for agent memory.
# Keeps learned processes/knowledge separate from application data.
AGENT_MEMORY_SUPABASE_URL=
AGENT_MEMORY_SUPABASE_SERVICE_ROLE_KEY=

# Used to encrypt provider tokens stored by the optional persistence layer.
WORKER_SECRET=

# Local Node server only
PORT=3000
